<div class="container m-auto">
<table class="table-auto border-collapse border my-5">
    <thead class="text-center">
        <tr class="text-2xl">Summary</tr>
     </thead>
  <tbody>
    <tr class="bg-slate">
        <td class="px-4 py-2 border font-bold">Picture</td>
        <td class="px-4 py-2 border font-bold">Title</td>
        <td class="px-4 py-2 border font-bold">Description</td>
        <td class="px-4 py-2 border font-bold">Auhtor</td>
        <td class="px-4 py-2 border font-bold">Status</td>
    </tr>
    <tr>
<td class="text-center">
    <% if @article.image.attached? %>
        <%= image_tag @article.image.variant(resize_to_fit: [250, 250]), class: "mx-auto" %>
        <p>Nazwa obrazka: <%= @article.image.filename.to_s %></p>
    <%else %>
     <p>Obrazek nie został załączony</p>
    <% end %>
</td>
    <td class="px-4 py-3 border"><%= @article.title %></td>
    <td class="px-4 py-3 border"><%= @article.body %></td>
    <td class="px-4 py-3 border"><%= @article.user ? @article.user.username : "Autor anonimowy" %></td>
    <td class="px-4 py-3 border"><%= @article.published ? 'Published' : 'Draft' %></td>
    </tr>
</tbody>
</table>


<div class="flex justify-between space-x-10">
  <button class="bg-yellow font-bold py-2 px-4 rounded-full">
    <%= link_to 'Edit this article', edit_article_path(@article), class: "mb-6" %>
  </button>
  
  <button class="bg-red font-bold py-2 px-4 rounded-full">
    <%= link_to "Delete this article", article_path(@article), data: {
      turbo_method: :delete,
      turbo_confirm: "Are you sure you want to delete the article?"
    } %>
  </button>
  
  <button class="bg-bermuda font-bold py-2 px-4 rounded-full">
    <%= link_to 'Back to Articles', articles_path %>
  </button>
</div>


</div>
